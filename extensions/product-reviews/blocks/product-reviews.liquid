{%- comment -%}
  Product reviews from the DAWAYO app and this shop, shared through process-list
  (app proxy /apps/dawayo-reviews). Signed-in customers can write one here.
  Place it in the product template from the theme editor.
{%- endcomment -%}
<section
  class="dw-reviews"
  data-dw-reviews
  data-product-id="gid://shopify/Product/{{ product.id }}"
  data-api="/apps/dawayo-reviews"
  data-product-title="{{ product.title | escape }}"
  data-signed-in="{% if customer %}1{% endif %}"
  data-login-url="{{ routes.account_login_url }}?return_url={{ product.url | url_encode }}"
  data-lang="{{ request.locale.iso_code }}"
  data-limit="{{ block.settings.limit }}"
  style="--dw-accent: {{ block.settings.accent_color }};"
>
  <h2 class="dw-reviews__title">{{ block.settings.heading }}</h2>
  <div class="dw-reviews__summary" hidden></div>
  <div class="dw-reviews__write"></div>
  <div class="dw-reviews__list" aria-live="polite"></div>
</section>

{% schema %}
{
  "name": "t:name",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "javascript": "product-reviews.js",
  "stylesheet": "product-reviews.css",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:settings.heading", "default": "Kundenbewertungen" },
    { "type": "range", "id": "limit", "label": "t:settings.limit", "min": 2, "max": 30, "step": 1, "default": 6 },
    { "type": "color", "id": "accent_color", "label": "t:settings.accent", "default": "#E30613" }
  ]
}
{% endschema %}
