generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model Session {
  id                String    @id
  shop              String
  state             String
  isOnline          Boolean   @default(false)
  scope             String?
  expires           DateTime?
  accessToken       String
  userId            BigInt?
  firstName         String?
  lastName          String?
  email             String?
  accountOwner      Boolean   @default(false)
  locale            String?
  collaborator      Boolean?  @default(false)
  emailVerified     Boolean?  @default(false)
  refreshToken      String?
  refreshTokenExpires DateTime?

  @@map("session")
}

model InspectionRecord {
  id                    String    @id @default(cuid())
  orderId               String    @unique  // ✨ 수정: upsert를 위해 @unique 제약 조건 추가
  orderName             String             // Shopify Order Name (e.g., #1001)
  shop                  String             // Shop domain
  inspectorName         String?            // Name of the person who inspected
  status                String             // SUCCESS, FAILED, PARTIAL, ISSUE_REPORTED
  isLieferscheinPrinted Boolean   @default(false) // 납품서 출력 여부
  lieferscheinPrintedAt DateTime?                 // 납품서 출력 일시
  isPickListPrinted     Boolean   @default(false) // 피킹 리스트 출력 여부
  customShippingAddress Json?                    // 수령인 주소 커스텀 수정본
  customBillingAddress  Json?                    // 영수증 주소 커스텀 수정본
  customVat             String?                  // 커스텀 VAT 등록 번호 (USt-IdNr.)
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  items                 InspectionItem[]

  @@index([shop])
  @@index([orderId])
}

model InspectionItem {
  id                 String           @id @default(cuid())
  inspectionRecordId String
  inspectionRecord   InspectionRecord @relation(fields: [inspectionRecordId], references: [id], onDelete: Cascade)
  variantId          String           // Shopify Variant ID
  productTitle       String
  variantTitle       String?
  sku                String?
  barcode            String?
  orderedQuantity    Int
  inspectedQuantity  Int

  // ✨ 결품 및 예외 처리 기록을 위한 컬럼 추가
  issueType               String?   // REFUND, CREDIT, SUBSTITUTE
  issueNote               String?   // 작업자 메모
  substitutedVariantId    String?   // 대체된 상품의 Variant ID
  substitutedProductTitle String?   // 대체된 상품명
}

model Recipe {
  id               String          @id @default(cuid())
  shop             String
  title            String
  introduction     String          @db.Text
  steps            String          @db.Text
  imageUrl         String?
  shopifyArticleId String?
  shopifyBlogId    String?
  published        Boolean         @default(false)
  
  // Extended Commerce & Metadata
  category         String          @default("STREET_FOOD") // STREET_FOOD, MAIN_DISH, SOUP_STEW, RICE, NOODLES, SIDE_DISH, DESSERT
  occasion         String?         @default("QUICK_MEAL")  // QUICK_MEAL, STUDENT, FAMILY, PARTY_BBQ, BEGINNER, SEASONAL
  difficulty       String          @default("EASY")        // EASY, MEDIUM, HARD
  prepTimeMinutes  Int             @default(10)
  cookTimeMinutes  Int             @default(15)
  servings         Int             @default(2)
  spiceLevel       Int             @default(2)             // 0: None, 1: Mild, 2: Medium, 3: Spicy, 4: Extra Spicy
  dietaryFlags     Json?                                   // Array of string flags, e.g. ["VEGETARIAN", "VEGAN", "GLUTEN_FREE", "HALAL"]
  translations     Json?                                   // { ko: { title, intro, steps }, de: { title, intro, steps }, en: { title, intro, steps } }
  ingredientsJson  Json?                                   // Structured ingredients: [{ id, nameKo, nameDe, nameEn, amount, unit, type, ... }]
  bundlesJson      Json?                                   // Defined bundle packages: [{ tier: 'ESSENTIAL', ... }, { tier: 'COMPLETE', ... }]
  scheduledAt      DateTime?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  products         RecipeProduct[]

  @@index([shop])
}

model RecipeProduct {
  id               String   @id @default(cuid())
  recipeId         String
  recipe           Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId        String   // Shopify Product GID (e.g. gid://shopify/Product/12345)
  variantId        String   // Shopify ProductVariant GID (e.g. gid://shopify/ProductVariant/67890)
  title            String   // Product title
  variantTitle     String?  // Variant title (e.g. "Default Title" or "500g")
  price            String?  // Product price
  imageUrl         String?  // Product image URL
  
  // Extended Commerce Matching
  ingredientName   String?  // Connected recipe ingredient name
  matchTier        String   @default("PRIMARY") // PRIMARY, ALTERNATIVE, BUDGET, PREMIUM
  confidenceScore  Float    @default(1.0)       // 0.0 - 1.0 match accuracy
  isApproved       Boolean  @default(true)      // Admin approval flag
  requiredQuantity Int      @default(1)         // Recommended package quantity for base recipe
  unit             String?  // e.g. "pack", "bottle", "can"
  isAvailable      Boolean  @default(true)      // Stock availability flag
}

model BackInStockSubscription {
  id           String    @id @default(cuid())
  shop         String
  productId    String    // Shopify Product GID or ID
  variantId    String    // Shopify Variant GID or ID
  productTitle String
  variantTitle String?
  sku          String?   // Product Variant SKU
  email        String
  phone        String?
  channel      String    @default("EMAIL") // EMAIL, PUSH, SMS
  status       String    @default("PENDING") // PENDING, NOTIFIED, CANCELLED
  etaDate      String?   // Expected arrival date (e.g. 2026-08-15)
  etaSource    String?   @default("ODOO")   // ODOO, MANUAL, FALLBACK
  subscribedAt DateTime  @default(now())
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([shop])
  @@index([variantId])
  @@index([status])
  @@index([email])
  @@index([shop, variantId, status])
  @@index([shop, status, createdAt])
}

model StorefrontNotice {
  id            String   @id @default(cuid())
  shop          String   @unique
  isActive      Boolean  @default(true)
  noticeVersion String   @default("v1.3.0")
  badgeTag      String   @default("NEW ANNOUNCEMENT")
  title         String   @default("다와요(Dawayo) 서비스 안내")
  subtext       String   @default("고객님께 더 빠르고 정확한 서비스를 제공하기 위해 시스템이 업데이트되었습니다.")
  itemsJson     Json     // Array of bullet items
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}