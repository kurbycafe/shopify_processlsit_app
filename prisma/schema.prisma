generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model Session {
  id                String    @id
  shop              String
  state             String
  isOnline          Boolean   @default(false)
  scope             String?
  expires           DateTime?
  accessToken       String
  userId            BigInt?
  firstName         String?
  lastName          String?
  email             String?
  accountOwner      Boolean   @default(false)
  locale            String?
  collaborator      Boolean?  @default(false)
  emailVerified     Boolean?  @default(false)
  refreshToken      String?
  refreshTokenExpires DateTime?

  @@map("session")
}

model InspectionRecord {
  id                    String    @id @default(cuid())
  orderId               String    @unique
  orderName             String             // Shopify Order Name (e.g., #1001)
  shop                  String             // Shop domain
  inspectorName         String?            // Name of the person who inspected
  status                String             // SUCCESS, FAILED, PARTIAL, ISSUE_REPORTED, PENDING
  isLieferscheinPrinted Boolean   @default(false) // 납품서 출력 여부
  lieferscheinPrintedAt DateTime?                 // 납품서 출력 일시
  isPickListPrinted     Boolean   @default(false) // 피킹 리스트 출력 여부
  isCancelAlertSent     Boolean   @default(false) // 취소/청약철회 알림 메일 발송 여부
  cancelAlertSentAt     DateTime?                 // 취소/청약철회 알림 메일 발송 일시
  customShippingAddress Json?                    // 수령인 주소 커스텀 수정본
  customBillingAddress  Json?                    // 영수증 주소 커스텀 수정본
  customVat             String?                  // 커스텀 VAT 등록 번호 (USt-IdNr.)
  invoiceNumber         String?
  invoiceYear           Int?
  invoiceSequence       Int?
  invoiceIssuedAt       DateTime?
  invoiceSnapshot       Json?
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  items                 InspectionItem[]

  @@index([shop])
  @@index([orderId])
  @@index([shop, status])
  @@index([shop, createdAt])
}

model InspectionItem {
  id                 String           @id @default(cuid())
  inspectionRecordId String
  inspectionRecord   InspectionRecord @relation(fields: [inspectionRecordId], references: [id], onDelete: Cascade)
  orderLineId        String?          // Shopify Order line item GID
  variantId          String           // Shopify Variant ID
  productTitle       String
  variantTitle       String?
  sku                String?
  barcode            String?
  orderedQuantity    Int
  inspectedQuantity  Int

  // 결품 및 예외 처리 기록
  issueType               String?   // REFUND, CREDIT, SUBSTITUTE
  issueNote               String?   // 작업자 메모
  substitutedVariantId    String?   // 대체된 상품의 Variant ID
  substitutedProductTitle String?   // 대체된 상품명

  @@index([inspectionRecordId])
  @@index([variantId])
  @@index([sku])
}

model Container {
  id            String          @id @default(cuid())
  shop          String
  containerRef  String          // PO 번호 또는 컨테이너 참조번호 (예: PO00412, CONT-2026-001)
  status        String          @default("SCHEDULED") // SCHEDULED, IN_TRANSIT, ARRIVED, RECEIVED, CANCELLED
  supplier      String?
  scheduledDate String?         // YYYY-MM-DD
  receivedAt    DateTime?
  notes         String?         @db.Text
  syncedAt      DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  items         ContainerItem[]

  @@unique([shop, containerRef])
  @@index([shop, status])
  @@index([scheduledDate])
}

model ContainerItem {
  id             String    @id @default(cuid())
  containerId    String
  container      Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  sku            String?
  barcode        String?
  productName    String
  expectedQty    Int       @default(0)
  receivedQty    Int       @default(0)
  unitPrice      Decimal?  @db.Decimal(10, 2)
  unitPerBox     Int       @default(0)
  boxQty         Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([containerId])
  @@index([sku])
}

model Recipe {
  id               String          @id @default(cuid())
  shop             String
  title            String
  introduction     String          @db.Text
  steps            String          @db.Text
  imageUrl         String?
  shopifyArticleId String?
  shopifyBlogId    String?
  published        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  products         RecipeProduct[]

  @@index([shop])
}

model RecipeProduct {
  id           String  @id @default(cuid())
  recipeId     String
  recipe       Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId    String  // Shopify Product GID (e.g. gid://shopify/Product/12345)
  variantId    String  // Shopify ProductVariant GID (e.g. gid://shopify/ProductVariant/67890)
  title        String  // Product title
  variantTitle String? // Variant title (e.g. "Default Title" or "500g")
  price        String? // Product price
  imageUrl     String? // Product image URL

  @@index([recipeId])
}

model BackInStockSubscription {
  id                   String    @id @default(cuid())
  shop                 String
  productId            String    // Shopify Product GID or ID
  variantId            String    // Shopify Variant GID or ID
  productTitle         String
  variantTitle         String?
  sku                  String?   // Product Variant SKU
  email                String
  phone                String?
  channel              String    @default("EMAIL") // EMAIL, PUSH, SMS
  status               String    @default("PENDING") // PENDING, PROCESSING, NOTIFIED, DELIVERED_UNCONFIRMED, FAILED, CANCELLED
  etaDate              String?   // Expected arrival date (e.g. 2026-08-15)
  poNumber             String?   // Odoo Purchase Order number (e.g. PO00412)
  restockedAt          DateTime? // Actual restock / receipt date
  subscribedAt         DateTime  @default(now())
  notifiedAt           DateTime?
  processingAt         DateTime?
  notificationAttempts Int       @default(0)
  lastNotificationError String?
  lastNotificationAt   DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([shop])
  @@index([variantId])
  @@index([status])
  @@index([email])
  @@index([poNumber])
  @@index([sku])
  @@index([shop, variantId, status])
  @@index([shop, status, createdAt])
  @@index([shop, variantId, email, status])
}

model StorefrontNotice {
  id            String   @id @default(cuid())
  shop          String   @unique
  isActive      Boolean  @default(true)
  noticeVersion String   @default("v1.3.0")
  badgeTag      String   @default("NEW ANNOUNCEMENT")
  title         String   @default("다와요(Dawayo) 서비스 안내")
  subtext       String   @default("고객님께 더 빠르고 정확한 서비스를 제공하기 위해 시스템이 업데이트되었습니다.")
  itemsJson     Json     // Array of bullet items
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model CustomerRequest {
  id         String   @id @default(cuid())
  shop       String
  type       String   // B2B, RETURN
  customerId String?
  orderId    String?
  requestKey String   @unique
  payload    Json
  status     String   @default("REQUESTED") // REQUESTED, REVIEWING, CLOSED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shop, status, id])
  @@index([shop, customerId, createdAt])
}

model CustomerNotificationPreference {
  id          String   @id @default(cuid())
  shop        String
  customerId  String
  pushEnabled Boolean  @default(false)
  orderUpdates Boolean @default(false)
  events      Boolean  @default(false)
  marketing   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, customerId])
}

model MobileBanner {
  id         String    @id @default(cuid())
  shop       String
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  tagKo      String    @default("주간 특가")
  tagDe      String?
  tagEn      String?
  titleKo    String
  titleDe    String?
  titleEn    String?
  subKo      String?
  subDe      String?
  subEn      String?
  badgeKo    String?
  badgeDe    String?
  badgeEn    String?
  ctaKo      String    @default("특가 보기")
  ctaDe      String?
  ctaEn      String?
  linkType   String    @default("TAB")
  linkValue  String    @default("deals")
  imageUrl   String
  bgGradient String    @default("linear-gradient(135deg, #E30613 0%, #B8000B 100%)")
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([shop, isActive, sortOrder])
}

model MobileHotDeal {
  id            String    @id @default(cuid())
  shop          String
  productId     String
  variantId     String
  productNameKo String
  productNameDe String?
  productNameEn String?
  imageUrl      String
  basePrice     Decimal   @db.Decimal(10, 2)
  salePrice     Decimal   @db.Decimal(10, 2)
  discountRate  Int
  badgeKo       String?
  badgeDe       String?
  badgeEn       String?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  dealEndsAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([shop, isActive, sortOrder])
}

model MobileCategoryConfig {
  id          String   @id @default(cuid())
  shop        String
  categoryKey String
  nameKo      String
  nameDe      String?
  nameEn      String?
  iconName    String
  isGnbTab    Boolean  @default(false)
  isCarousel  Boolean  @default(true)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  badgeTag    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, categoryKey])
  @@index([shop, isActive, sortOrder])
}

model MobileStorefrontConfig {
  id                    String   @id @default(cuid())
  shop                  String   @unique
  freeShippingThreshold Decimal  @default(60.00) @db.Decimal(10, 2)
  shippingNoticeKo      String   @default("독일 전역 60€ 이상 무료배송 · 신선 안심 보랭 출고")
  shippingNoticeDe      String   @default("Kostenloser Versand ab 60€ in ganz Deutschland")
  shippingNoticeEn      String   @default("Free shipping over 60€ across Germany")
  tickersJson           Json
  configVersion         String   @default("1.0.0")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CustomerReaction {
  id         String   @id @default(cuid())
  shop       String
  targetType String
  targetId   String
  customerId String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shop, targetType, targetId, customerId])
  @@index([shop, targetType, targetId, active])
}

model AppUsageLog {
  id        String   @id @default(cuid())
  shop      String
  path      String
  tabName   String
  user      String?
  createdAt DateTime @default(now())

  @@index([shop, path])
  @@index([shop, createdAt])
}
