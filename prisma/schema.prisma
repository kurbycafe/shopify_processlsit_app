generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model Session {
  id                String    @id
  shop              String
  state             String
  isOnline          Boolean   @default(false)
  scope             String?
  expires           DateTime?
  accessToken       String
  userId            BigInt?
  firstName         String?
  lastName          String?
  email             String?
  accountOwner      Boolean   @default(false)
  locale            String?
  collaborator      Boolean?  @default(false)
  emailVerified     Boolean?  @default(false)
  refreshToken      String?
  refreshTokenExpires DateTime?

  @@map("session")
}

model InspectionRecord {
  id                    String    @id @default(cuid())
  orderId               String    @unique  // ✨ 수정: upsert를 위해 @unique 제약 조건 추가
  orderName             String             // Shopify Order Name (e.g., #1001)
  shop                  String             // Shop domain
  inspectorName         String?            // Name of the person who inspected
  status                String             // SUCCESS, FAILED, PARTIAL, ISSUE_REPORTED
  isLieferscheinPrinted Boolean   @default(false) // 납품서 출력 여부
  lieferscheinPrintedAt DateTime?                 // 납품서 출력 일시
  isPickListPrinted     Boolean   @default(false) // 피킹 리스트 출력 여부
  customShippingAddress Json?                    // 수령인 주소 커스텀 수정본
  customBillingAddress  Json?                    // 영수증 주소 커스텀 수정본
  customVat             String?                  // 커스텀 VAT 등록 번호 (USt-IdNr.)
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  items                 InspectionItem[]

  @@index([shop])
  @@index([orderId])
}

model InspectionItem {
  id                 String           @id @default(cuid())
  inspectionRecordId String
  inspectionRecord   InspectionRecord @relation(fields: [inspectionRecordId], references: [id], onDelete: Cascade)
  variantId          String           // Shopify Variant ID
  productTitle       String
  variantTitle       String?
  sku                String?
  barcode            String?
  orderedQuantity    Int
  inspectedQuantity  Int

  // ✨ 결품 및 예외 처리 기록을 위한 컬럼 추가
  issueType               String?   // REFUND, CREDIT, SUBSTITUTE
  issueNote               String?   // 작업자 메모
  substitutedVariantId    String?   // 대체된 상품의 Variant ID
  substitutedProductTitle String?   // 대체된 상품명
}

model ReturnRecord {
  id              String       @id @default(cuid())
  orderName       String       // 주문 번호 (예: #1001)
  returnedAt      DateTime     @default(now()) // 반송 받은 날짜
  isDamaged       Boolean      @default(false) // 파손 여부
  damageReason    String?      // 파손 사유
  isProcessed     Boolean      @default(false) // 처리 완료 여부
  processingType  String?      // 반품 처리 유형 (예: RESTOCK, DISCARD, REFUND, EXCHANGE, OTHER)
  processingNotes String?      // 반품 처리 메모
  processedAt     DateTime?    // 반품 처리 일시
  inspectorName   String?      // 검수 작업자명
  shop            String       // 상점 도메인
  carrier         String?      // 반송 택배사 (예: DHL, UPS, DPD, FEDEX, OTHER, NONE)
  returnReasonType String?     // 반송 귀책 구분 (예: CUSTOMER_ERROR, CARRIER_ERROR, CHANGE_OF_MIND, OTHER)
  returnReasonDetails String?   // 상세 반송 사유 (예: 주소 불명 등)
  storageLocation String?      // 반송 보관 위치
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           ReturnItem[]

  @@index([shop])
}

model ReturnItem {
  id             String       @id @default(cuid())
  returnRecordId String
  returnRecord   ReturnRecord @relation(fields: [returnRecordId], references: [id], onDelete: Cascade)
  productTitle   String
  variantTitle   String?
  sku            String?
  barcode        String?
  quantity       Int          @default(1)
}