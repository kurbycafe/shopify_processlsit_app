{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "build/client",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "schedule": "*/5 * * * *",
      "path": "/api/mobile-push-dispatch"
    },
    {
      "schedule": "7 * * * *",
      "path": "/api/arrivals-sync"
    }
  ]
}
