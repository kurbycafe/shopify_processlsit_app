{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "build/client",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "schedule": "*/5 * * * *",
      "path": "/api/mobile-push-dispatch"
    },
    {
      "schedule": "7 * * * *",
      "path": "/api/arrivals-sync"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{app/assets/fonts/**,node_modules/harfbuzzjs/dist/harfbuzz-subset.wasm,node_modules/@sparticuz/chromium/bin/**}"
    }
  }
}
